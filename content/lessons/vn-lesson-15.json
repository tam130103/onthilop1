        "iêu — diều (cánh diều lượn bay)",
        "uôi — chuối (nải chuối chín vàng)",
        "ươi — bưởi (quả bưởi da xanh)",
        "ươu — hươu (chú hươu sao hiền lành)"
      ]
    },
