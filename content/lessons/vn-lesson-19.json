      "audio": "/media/tts/vn19-intro.mp3",
      "bullets": [
        "l — lúa (đồng lúa chín vàng)",
        "n — nón (chiếc nón lá nghiêng che)",
        "an — bạn (bạn bè thân thiết)",
        "ang — vàng (sắc hoa vàng tươi)"
      ]
    },
